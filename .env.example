# Copy to .env for local development. NEVER commit real values; in staging/production inject these from the
# secret manager (see deploy/k8s/secret.example.yaml for the names).

APP_ENV=development            # development | staging | production (production forbids mock providers, http, non-S3 storage)
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/content_agent

# Service-to-service auth. Comma-separated, >=32 chars each; list the old + new secret during rotation.
INTERNAL_AUTH_SECRETS=change-me-change-me-change-me-change-me

# LLM (mock | anthropic | openai). Any OpenAI-compatible gateway works via LLM_BASE_URL.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
IMAGE_PROVIDER=mock            # mock | openai | none
IMAGE_MODEL=gpt-image-1

# Zernio (service API key only; customer OAuth tokens are never held here)
ZERNIO_BASE_URL=https://zernio.com/api   # confirm against your Zernio account
ZERNIO_API_KEY=

# Extractors
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
OBSCURA_BIN=obscura
OBSCURA_MAX_CONCURRENCY=4
OBSCURA_TIMEOUT_SECS=45

# Storage (s3 = any S3-compatible endpoint; local/memory are dev only)
STORAGE_KIND=local
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/assets
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# URL controls
ALLOW_HTTP=false
URL_ALLOWLIST=                 # optional comma-separated hosts; empty = any public host
URL_DENYLIST=
EGRESS_PROXY=                  # optional http(s)/socks5 egress proxy

# Feature flags
EXTRACTOR_HTTP_ENABLED=true
EXTRACTOR_OBSCURA_ENABLED=true
EXTRACTOR_FIRECRAWL_ENABLED=true
PREFER_FIRECRAWL=false
RESPECT_ROBOTS=true
DISABLED_TOOLS=                # comma-separated tool names to switch off (e.g. publish_draft)

# Limits
RATE_TENANT_PER_MIN=600
RATE_BRAND_PER_MIN=300
RATE_TOOL_PER_MIN=120
RATE_PROVIDER_PER_MIN=600
TOOL_TIMEOUT_SECS=90
MAX_BODY_BYTES=1048576
WORKER_CONCURRENCY=4
RETENTION_SOURCE_DAYS=         # purge extracted text/screenshots older than N days (worker)

REVIEW_URL_TEMPLATE=https://app.letwemarket.com/brands/{brand_id}/content/review/{draft_id}
USAGE_WEBHOOK_URL=
USAGE_WEBHOOK_SECRET=
# Developer console at /console (browser signs requests with a secret you type in). Dev/staging only: refused in production.
CONSOLE_ENABLED=false
RUST_LOG=info
