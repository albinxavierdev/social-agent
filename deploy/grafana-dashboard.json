{
  "title": "Content Agent", "schemaVersion": 39, "refresh": "30s", "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Tool requests by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (tool,status) (rate(tool_requests_total[5m]))" }] },
    { "type": "timeseries", "title": "Tool latency p95", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,tool) (rate(tool_latency_seconds_bucket[5m])))" }] },
    { "type": "timeseries", "title": "Queue depth / oldest pending (s)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "queue_depth" }, { "expr": "queue_oldest_pending_age_seconds" }, { "expr": "queue_dead_letters" }] },
    { "type": "timeseries", "title": "Retries and dead letters", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (kind) (rate(queue_retries_total[5m]))" }, { "expr": "sum by (kind) (increase(queue_tasks_total{outcome=\"dead_letter\"}[1h]))" }] },
    { "type": "timeseries", "title": "Extraction success by extractor", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (extractor) (rate(extraction_attempts_total{outcome=\"success\"}[15m])) / sum by (extractor) (rate(extraction_attempts_total[15m]))" }] },
    { "type": "timeseries", "title": "LLM tokens and cost", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (kind) (rate(llm_tokens_total[5m]))" }, { "expr": "sum(rate(llm_cost_usd_micros_total[5m])) / 1e6" }] },
    { "type": "timeseries", "title": "Zernio success / failure", "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (op,outcome) (rate(zernio_requests_total[5m]))" }, { "expr": "sum by (outcome) (rate(zernio_publish_total[15m]))" }] },
    { "type": "timeseries", "title": "Rate-limit hits / browser pool / image validation failures", "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (scope) (rate(rate_limit_hits_total[5m]))" }, { "expr": "browser_pool_utilisation" }, { "expr": "sum(rate(image_validation_total{outcome=\"failed\"}[30m])) / sum(rate(image_validation_total[30m]))" }] }
  ]
}
